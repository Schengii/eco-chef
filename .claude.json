{
  "$schema": "https://json.schemastore.org/partial-claude-code-settings.json",
  "permissions": {
    "allow": [
      "npm test",
      "npm run test",
      "npm run dev",
      "npm run build",
      "git status",
      "git diff"
    ],
    "deny": [
      "git push --force",
      "rm -rf platforms",
      "rm -rf plugins"
    ]
  }
}
