{
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in dependabot/*) exit 0;; *) exit 1;; esac",
  "buildCommand": "npm run build",
  "outputDirectory": "www",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/gemini.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

