# ==============================================================================
# Claude Code Ignore Rules (.claudeignore)
# ==============================================================================
# Verhindert, dass Claude unnötige, riesige oder sensible Dateien indiziert.
# Spart Tokens, verhindert Latenzen und schützt Geheimnisse.
# ==============================================================================

# Version Control
.git/

# Dependencies & Lockfiles
node_modules/
package-lock.json

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Build Outputs & Bundles
dist/
www/
coverage/
test-results/
playwright-report/
blob-report/
*.tsbuildinfo

# Vercel Deployment & Caches
.vercel/

# Apache Cordova Native Artifacts & Plugins
platforms/
plugins/

# IDE & Editor Files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.settings/
.classpath

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# AI Assistant Brain & System Dumps
.gemini/
.system_generated/

# OS Specific
.DS_Store
Thumbs.db
Desktop.ini

# Large Binary / Media Assets
ui-src/assets/*.mp3
ui-src/assets/*.wav
ui-src/assets/icon.png
ui-src/assets/splash.png
