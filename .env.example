# ==============================================================================
# EcoChef Environment Variables Template (.env.example)
# ==============================================================================
# Kopiere diese Datei nach ".env" und trage deine echten Werte ein:
# cp .env.example .env
#
# Die Datei ".env" wird von Git ignoriert und darf NIEMALS eingecheckt werden.
# ==============================================================================

# --- Google Gemini AI Konfiguration (Erforderlich) ---
# Key erstellen unter: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional: Upstash Redis (Vercel Rate Limiting) ---
# Wird für verteilte Rate Limits in Vercel Serverless Functions (/api/gemini) verwendet.
# Falls leer gelassen, nutzt die API einen In-Memory Speicher pro Funktionsinstanz.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Entwicklung & Server ---
# NODE_ENV=development
# PORT=4444
