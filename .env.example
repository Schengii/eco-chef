# EcoChef Environment Variables
# ================================
# Copy this file to ".env" and fill in your API key.
# The ".env" file is git-ignored and will NOT be committed to source control.

# Google Gemini API Key (required for AI recipe generation)
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
