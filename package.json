{
  "name": "com.schenk.ecochef",
  "displayName": "EcoChef",
  "version": "1.1.0",
  "description": "EcoChef - Dein intelligenter KI-Rezept-Zauberer. Koche nachhaltig mit deinen Kühlschrankzutaten.",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "e2e": "playwright test",
    "type-check": "tsc --noEmit && tsc -p api/tsconfig.json --noEmit",
    "dev": "kill-port --port 4444 && webpack serve --mode=development",
    "build": "webpack --mode=production",
    "analyze": "webpack --mode=production --env analyze",
    "check:secrets": "node .githooks/check-secrets.js",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Max Schenk",
  "license": "Apache-2.0",
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      },
      "cordova-plugin-network-information": {}
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/qrcode-generator": "^1.0.6",
    "baseline-browser-mapping": "^2.11.34",
    "cordova-android": "^15.1.0",
    "cordova-plugin-camera": "^8.0.0",
    "cordova-plugin-network-information": "^3.0.0",
    "css-loader": "^7.1.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "html-webpack-plugin": "5.6.8",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.5.2",
    "kill-port": "2.0.1",
    "mini-css-extract-plugin": "2.10.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "lit": "^3.3.3",
    "qrcode-generator": "^2.0.4",
    "zod": "^4.6.7"
  }
}
