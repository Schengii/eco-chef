{
  "name": "com.schenk.ecochef",
  "displayName": "EcoChef",
  "version": "1.0.0",
  "description": "EcoChef - Dein intelligenter KI-Rezept-Zauberer. Koche nachhaltig mit deinen Kühlschrankzutaten.",
  "scripts": {
    "test": "jest",
    "dev": "kill-port --port 4444 && webpack serve --mode=development",
    "build": "webpack --mode=production",
    "analyze": "webpack --mode=production --env analyze"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Max Schenk",
  "license": "Apache-2.0",
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      },
      "cordova-plugin-network-information": {}
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@vercel/node": "^16.0.2",
    "webpack-bundle-analyzer": "^5.4.0",
    "baseline-browser-mapping": "^2.11.26",
    "cordova-android": "^15.1.0",
    "cordova-plugin-camera": "^8.0.0",
    "css-loader": "7.1.5",
    "html-webpack-plugin": "5.6.8",
    "jest": "^30.5.2",
    "kill-port": "2.0.1",
    "mini-css-extract-plugin": "2.10.2",
    "ts-jest": "^29.4.14",
    "ts-loader": "9.6.2",
    "typescript": "^7.0.2",
    "url-loader": "^4.1.1",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0",
    "cordova-plugin-network-information": "^3.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.20.0",
    "lit": "3.3.1"
  }
}
