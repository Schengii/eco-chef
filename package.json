  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      }
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.5",
    "baseline-browser-mapping": "^2.10.0",
    "cordova-android": "^15.0.0",
    "cordova-plugin-camera": "^8.0.0",
    "css-loader": "7.1.2",
    "html-webpack-plugin": "5.6.3",
    "jest": "^30.4.2",
    "kill-port": "2.0.1",
    "mini-css-extract-plugin": "2.9.4",
    "ts-jest": "^29.4.11",
    "ts-loader": "9.5.2",
    "typescript": "^5.9.2",
    "url-loader": "^4.1.1",
    "webpack": "5.101.1",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.2"
  },
  "dependencies": {
    "@google/genai": "^1.20.0",
    "lit": "3.3.1"
  }
