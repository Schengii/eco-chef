{
  "name": "com.schenk.ecochef",
  "displayName": "EcoChef",
  "version": "1.0.0",
  "description": "EcoChef - Dein intelligenter KI-Rezept-Zauberer. Koche nachhaltig mit deinen Kühlschrankzutaten.",
  "scripts": {
    "test": "jest",
    "dev": "kill-port --port 4444 && webpack serve --mode=development",
    "build": "webpack --mode=production"
  },
