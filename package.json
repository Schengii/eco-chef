{
  "name": "com.schenk.ecochef",
  "displayName": "EcoChef",
  "version": "1.0.0",
  "description": "EcoChef - Dein intelligenter KI-Rezept-Zauberer. Koche nachhaltig mit deinen Kühlschrankzutaten.",
  "scripts": {
    "test": "jest",
    "type-check": "tsc --noEmit && tsc -p api/tsconfig.json --noEmit",
    "dev": "kill-port --port 4444 && webpack serve --mode=development",
    "build": "webpack --mode=production",
    "analyze": "webpack --mode=production --env analyze"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Max Schenk",
  "license": "Apache-2.0",
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      },
      "cordova-plugin-network-information": {}
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.5",
    "@vercel/node": "^4.0.0",
    "baseline-browser-mapping": "^2.10.0",
    "cordova-android": "^9.0.0",
    "cordova-plugin-camera": "^8.0.0",
    "cordova-plugin-network-information": "^3.0.0",
    "css-loader": "7.1.2",
    "html-webpack-plugin": "5.6.3",
    "jest": "^30.4.2",
    "kill-port": "2.0.1",
    "mini-css-extract-plugin": "2.9.4",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.2",
    "url-loader": "^4.1.1",
    "webpack": "^5.111.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "^5.2.6"
  },
  "dependencies": {
    "@google/genai": "^1.20.0",
    "@types/qrcode-generator": "^0.0.16",
    "@vercel/analytics": "^2.0.1",
    "lit": "3.3.1",
    "qrcode-generator": "^2.0.4"
  }
}
